-- 4. Conditions du site (texte français) : paiement et annulation
update public.site_settings
set conditions = jsonb_set(
  conditions, '{fr}',
  (select jsonb_agg(
            case when e.value = to_jsonb('Paiement : virement, Wave, Paypal'::text)
                 then to_jsonb('Paiement de la totalité du séjour sous 72 h après l''acceptation de votre demande : virement, Wave ou PayPal.'::text)
                 else e.value end
            order by e.ord)
   from jsonb_array_elements(conditions->'fr') with ordinality as e(value, ord))
)
where conditions->'fr' @> to_jsonb('Paiement : virement, Wave, Paypal'::text);

update public.site_settings
set conditions = jsonb_set(
  conditions, '{fr}',
  (conditions->'fr') || to_jsonb('Annulation : remboursement à 100 % si vous annulez 15 jours ou plus avant l''arrivée, à 50 % entre 14 et 8 jours avant, aucun remboursement à 7 jours ou moins.'::text)
)
where not (conditions->'fr' @> to_jsonb('Annulation : remboursement à 100 % si vous annulez 15 jours ou plus avant l''arrivée, à 50 % entre 14 et 8 jours avant, aucun remboursement à 7 jours ou moins.'::text));