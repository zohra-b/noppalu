-- LANCER CHAQUE REQUETE SEPAREMENT

-- 1. Suivi du paiement
alter table public.booking_requests
  add column accepted_at timestamptz,
  add column paid_at timestamptz,
  add column confirmation_sent_at timestamptz;

-- 2. accepter_demande enregistre l'heure d'acceptation (départ du délai de 72 h)
create or replace function public.accepter_demande(p_id uuid)
returns void
language plpgsql
set search_path = ''
as $$
declare
  d public.booking_requests%rowtype;
begin
  select * into d from public.booking_requests where id = p_id for update;
  if not found then raise exception 'demande_introuvable'; end if;
  if d.status <> 'nouvelle' then raise exception 'statut_invalide'; end if;

  insert into public.availability_blocks
    (bungalow_slug, start_date, end_date, source, guest_name, note, request_id)
  values
    (d.bungalow_slug, d.start_date, d.end_date, 'demande_site', d.guest_name,
     'Demande acceptée', d.id);

  update public.booking_requests
  set status = 'acceptee', accepted_at = now()
  where id = d.id;
end;
$$;

revoke all on function public.accepter_demande(uuid) from public, anon, authenticated;
grant execute on function public.accepter_demande(uuid) to service_role;

-- 3. Coordonnées de paiement : table PRIVÉE (aucun accès public)
create table public.payment_details (
  id            boolean primary key default true check (id),
  wave_number   text,
  iban          text,
  iban_holder   text,
  paypal_email  text
);

alter table public.payment_details enable row level security;
revoke all on public.payment_details from anon, authenticated;
grant select, update on public.payment_details to service_role;

